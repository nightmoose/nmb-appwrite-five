# Appwrite mode (python -m nmb_five demo --mode appwrite)
APPWRITE_ENDPOINT=https://<REGION>.cloud.appwrite.io/v1
APPWRITE_PROJECT_ID=
APPWRITE_API_KEY=
APPWRITE_TABLESDB_ID=
APPWRITE_DOCUMENTSDB_ID=
APPWRITE_VECTORSDB_ID=
# From the database's Credentials dialog in the Console
APPWRITE_POSTGRES_DSN=postgresql://admin:<password>@<host>/<db>?sslmode=require
APPWRITE_MYSQL_HOST=
APPWRITE_MYSQL_USER=admin
APPWRITE_MYSQL_PASSWORD=
APPWRITE_MYSQL_DATABASE=
# SQL transport: "api" (Appwrite SQL API over HTTPS, port 443) or "driver" (DSN / host below)
APPWRITE_SQL_TRANSPORT=api
APPWRITE_POSTGRES_ID=
APPWRITE_MYSQL_ID=
APPWRITE_MYSQL_PORT=3306
